# Brightloop 360 - Database Configuration
# Copy this file to .env and update with your local/staging/production credentials.

# Option 1: Full Database Connection URL
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/brightloop360

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brightloop360
DB_SSLMODE=prefer

# SQLAlchemy Engine & Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

